// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VisitStatus {
  PENDING
  APPROVED
  REJECTED
  CHECKED_IN
  CHECKED_OUT
  EXPIRED
  OVERSTAY
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model Employee {
  id                String  @id @default(cuid())
  fullName          String
  email             String  @unique
  password          String
  department        String
  phone             String
  photoUrl          String?
  isApproved        Boolean @default(false)
  maxVisitorsPerDay Int     @default(10)

  visits Visit[]
}

model Visitor {
  id       String  @id @default(cuid())
  fullName String
  email    String
  phone    String
  company  String?

  visits Visit[]
}

model Visit {
  id     String      @id @default(cuid())
  status VisitStatus @default(PENDING)

  purpose  String
  photoUrl String?

  checkInAt  DateTime?
  checkOutAt DateTime?

  preApproved Boolean   @default(false)
  windowStart DateTime?
  windowEnd   DateTime?

  qrCode        String? @unique
  approvalToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id])
  hostId    String
  host      Employee @relation(fields: [hostId], references: [id])
}
