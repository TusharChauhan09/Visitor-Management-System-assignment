# Local PostgreSQL via Docker (see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Hosted Postgres (e.g. Neon) — use on Vercel instead of Docker
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local dev only — approve/deny links in email when APP_URL is localhost
# EMAIL_APP_URL=https://your-app.vercel.app

SESSION_SECRET=change-this-to-a-long-random-string-in-production

RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# Local dev only — redirect host emails while using onboarding@resend.dev
RESEND_TEST_TO=
